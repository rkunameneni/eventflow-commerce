{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rkunameneni/eventflow-commerce/schemas/PaymentCompleted.schema.json",
  "title": "PaymentCompleted",
  "description": "Published by payment-service on eventflow.payment.completed.v1 after a successful charge.",
  "type": "object",
  "required": ["eventId", "orderId", "customerId", "paymentId", "amount", "currency", "occurredAt"],
  "properties": {
    "eventId": { "type": "string", "format": "uuid" },
    "orderId": { "type": "string", "format": "uuid" },
    "customerId": { "type": "string", "minLength": 1 },
    "paymentId": { "type": "string", "format": "uuid" },
    "amount": { "type": "number", "exclusiveMinimum": 0 },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "occurredAt": { "type": "string", "format": "date-time" }
  }
}
